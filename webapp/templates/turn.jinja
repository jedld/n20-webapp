{% set legendary_entity = battle.legendary_phase_entity() if battle.legendary_phase_entity is defined else none %}
{% if legendary_entity %}
    {% set entity = legendary_entity %}
    {% set turn_entity = battle.current_turn() %}
    {% if controller_of(entity.entity_uid, username) %}
        <img class="current-turn-img legendary-phase-img" src="/assets/{{ entity.token_image() }}" style="max-width: 75px;">
        <div class="legendary-phase-info">
            <span class="legendary-phase-tag">Legendary Action</span>
            {% if turn_entity %}<small>after {{ turn_entity.label() }}'s turn</small>{% endif %}
        </div>
        <button class="btn btn-warning" id="player-end-turn" data-legendary-phase="1" style="pointer-events: auto">End Legendary Action</button>
        <div class="indicator-container">
            <div class="indicator legendary" title="Legendary actions remaining" data-toggle="tooltip" data-placement="top">
                <span>{{ entity.total_legendary_actions(battle) or 0 }} LA</span>
            </div>
        </div>
    {% else %}
    <div class="current-turn-information">
        <img class="current-turn-img legendary-phase-img" src="/assets/{{ entity.token_image() }}" style="max-width: 75px; margin-right: 10px;">
        <p class="lead" style="margin: 0;">{{ entity.label() }} is taking a legendary action&hellip;</p>
    </div>
    {% endif %}
{% elif battle.current_turn() %}
    {% set entity = battle.current_turn() %}
    
    {% if  controller_of(entity.entity_uid, username) %}
        <img class="current-turn-img" src="/assets/{{ entity.token_image() }}" style="max-width: 75px;">
        <button class="btn btn-primary" id="player-end-turn" style="pointer-events: auto">End Turn</button>
            <div class="indicator-container" >
        <div class="indicator action" style="background-color: blue;" title="Action" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.total_actions(battle) }}</span>
        </div>
        <div class="indicator bonus-action" style="background-color: green;" title="Bonus Action" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.total_bonus_actions(battle) }}</span>
        </div>
        <div class="indicator movement" style="background-color: teal;" title="Movement" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.available_movement(battle) }}ft</span>
        </div>
        {% if entity.legendary_actions is defined and entity.legendary_actions %}
        <div class="indicator legendary" title="Legendary actions (used after other creatures' turns)" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.total_legendary_actions(battle) or 0 }} LA</span>
        </div>
        {% endif %}
        {% if entity.max_ki|default(0) %}
        <div class="indicator ki" style="background-color: #b07d00;" title="Ki Points" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.ki_count or 0 }}/{{ entity.max_ki }} Ki</span>
        </div>
        {% endif %}
        {% if entity.rage_max|default(0) %}
        <div class="indicator rage" style="background-color: #c0392b;" title="Rage Uses{% if entity.is_raging() %} - RAGING ({{ entity.rage_rounds_remaining }} rd){% endif %}" data-toggle="tooltip" data-placement="top">
            <span>{{ entity.rage_count or 0 }}/{{ entity.rage_max }}{% if entity.is_raging() %} ⚔{% endif %}</span>
        </div>
        {% endif %}
    </div>
        {% set _pools = entity.character_resource_pools() if entity.character_resource_pools is defined else {} %}
        {% if _pools %}
        {% set _restore_labels = {'short_rest': 'short rest', 'long_rest': 'long rest', 'turn': 'each turn', 'never': 'no refill'} %}
        {% set _depleted = _pools.values() | selectattr('current', 'equalto', 0) | list | length %}
        <div id="resource-pools-panel" class="resource-pools-panel">
            <button id="resource-pools-toggle" class="resource-pools-toggle" style="pointer-events: auto" title="Show or hide class resource pools">
                <span class="rpp-arrow">&#9656;</span>
                <span class="rpp-title">Class Resources</span>
                <span class="rpp-summary{% if _depleted %} depleted{% endif %}" title="{% if _depleted %}{{ _depleted }} pool(s) at 0{% else %}All pools have charges{% endif %}">
                    {{ _pools | length }}{% if _depleted %} (&#9888;{{ _depleted }}){% endif %}
                </span>
            </button>
            <div class="resource-pools-body">
                {% for resource_name, resource in _pools.items() %}
                {% set label = resource_name | resource_pool_label %}
                {% set pct = (100 * resource.current // resource.max_value) if resource.max_value else 0 %}
                <div class="resource-pool-row{% if resource.current == 0 %} depleted{% endif %}"
                     title="{{ label }}: {{ resource.current }} of {{ resource.max_value }} remaining, refills on {{ _restore_labels.get(resource.restore_on, resource.restore_on) }}">
                    <div class="rpp-top">
                        <span class="rpp-name">{{ label }}</span>
                        <span class="rpp-value">{{ resource.current }}/{{ resource.max_value }}</span>
                        <span class="rpp-restore">{{ _restore_labels.get(resource.restore_on, resource.restore_on) }}</span>
                    </div>
                    <div class="rpp-bar"><div class="rpp-bar-fill" style="width: {{ pct }}%;"></div></div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    {% else %}
    <div class="current-turn-information" style="">
        <img class="current-turn-img" src="/assets/{{ entity.token_image() }}" style="max-width: 75px; margin-right: 10px;">
        <p class="lead" style="margin: 0;">Waiting for {{ entity.label() }}</p>
    </div>
    {% endif %}

{% endif %}
