# Copy to webapp/.env and adjust.

# DM AI assistant (sidebar chat, MCP tools, campaign help)
LLM_PROVIDER=llamacpp
LLAMA_CPP_BASE_URL=http://localhost:8000
LLAMA_CPP_MODEL=Qwen3.6-35B-A3B-MTP-Q6_K

# NPC conversation LLM (JRPG dialog, /talk — separate endpoint/model from DM assistant)
NPC_LLM_ENABLED=1
NPC_LLM_PROVIDER=llamacpp
NPC_BASE_URL=http://localhost:8001
NPC_MODEL=gemma4:26b-a4b-5060ti-llama
# NPC_LLM_TIMEOUT=180
# NPC_LLM_MAX_TOKENS=320
# NPC context window (tokens). Unset = auto-detect from server or provider default.
# NPC_LLM_CONTEXT_SIZE=32768
# N20_NPC_CONTEXT_SIZE=32768
# N20_LLM_CONTEXT_AUTO_DETECT=1
# N20_LLM_CONTEXT_SAFETY_MARGIN=512
# N20_LLM_CONTEXT_COMPACT_PCT=85
# N20_NPC_CONTEXT_KEEP_RECENT_TURNS=6

# --- Jev (TypeSafe "System One") decision model (optional) ---
# A *decision* model (not a prose generator). Use LLM_PROVIDER=jev to let the
# controller pick combat actions via Jev's typed decide_action API (returns
# index + confidence + probabilities). Jev cannot write narration/dialogue, so
# keep NPC conversation on a generative provider. Requires: pip install typesafe-sdk
# LLM_PROVIDER=jev
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
# JEV_TIMEOUT=8

FLASK_ENV=development

# Campaign directory (absolute path or slug when N20_CAMPAIGNS_DIR is set)
TEMPLATE_DIR=wild_sheep_chase
# N20_CAMPAIGNS_DIR=../n20-campaigns

CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5001,http://127.0.0.1:5001

TTS_ENABLED=1
TTS_PROVIDER=mock_cosyvoice

# --- Low-latency production stack (vLLM-Omni sidecar) ---
# Start sidecar: cd services/vllm-omni-tts && ./start_with_voices.sh
# TTS_PROVIDER=qwen3_vllm
# VLLM_OMNI_TTS_URL=http://127.0.0.1:8091
# VLLM_OMNI_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# TTS_DELIVERY=stream
# VLLM_OMNI_TTS_REGISTER_ON_START=1
# VLLM_OMNI_TTS_SOCKET_PCM=1
# Optional explicit opt-out of live PCM during stream delivery:
# VLLM_OMNI_TTS_SOCKET_PCM=0
