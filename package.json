{
  "name": "n20-webapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "ci:test": "jest --coverage --runInBand",
    "build:assets": "node scripts/minify.mjs",
    "optimize:images": "python webapp/scripts/optimize_web_assets.py --profile full",
    "optimize:assets": "npm run build:assets && npm run optimize:images"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "coverageProvider": "v8",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "webapp/static/**/*.js",
      "!webapp/static/**/*.test.js",
      "!webapp/static/**/*.min.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "webapp/static/libs/"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.0.5",
    "jquery": "^3.7.0",
    "jsdom": "^21.0.0"
  },
  "overrides": {
    "js-yaml": "3.15.1",
    "form-data": "4.0.6",
    "ws": "8.21.3",
    "minimatch": "3.1.5",
    "brace-expansion": "1.1.18",
    "picomatch": "2.3.2",
    "@babel/core": "7.29.6",
    "@tootallnate/once": "2.0.1"
  }
}
